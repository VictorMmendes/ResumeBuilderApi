<% resume ||= local_assigns[:resume] || @resume %>
<% payload ||= local_assigns[:payload] || ResumePayloadBuilder.new(resume).call %>
<%
  require "uri"

  contact = payload[:contact] || {}
  hero_location = [ contact[:city], contact[:region], contact[:country] ].reject(&:blank?).join(", ")
  base_location = contact[:street_address].presence || hero_location
  format_month_year = ->(date) { date&.strftime("%B %Y") }
  format_period = lambda do |start_date, end_date, current|
    start_label = format_month_year.call(start_date)
    end_label = current ? "Present" : format_month_year.call(end_date)
    [start_label, end_label].reject(&:blank?).join(" - ")
  end
  sanitize_link_label = lambda do |url|
    next if url.blank?

    parsed = URI.parse(url)
    [ parsed.host&.sub(/\Awww\./, ""), parsed.path.presence ].compact.join
  rescue URI::InvalidURIError
    url
  end
  profile_initials = payload[:full_name].to_s.split.filter_map { |part| part[0] }.first(2).join.upcase
  contact_entries = [
    [ "Address", base_location, nil ],
    [ "Phone", contact[:phone], "tel:#{contact[:phone]}" ],
    [ "Email", contact[:email], "mailto:#{contact[:email]}" ],
    [ "LinkedIn", sanitize_link_label.call(contact[:linkedin_url]), contact[:linkedin_url] ],
    [ "GitHub", sanitize_link_label.call(contact[:github_url]), contact[:github_url] ],
    [ "Portfolio", contact[:portfolio_label], nil ]
  ].select { |_, value, _| value.present? }
  facts = [
    [ payload[:experience_groups].sum { |group| group[:positions].size }, "Positions" ],
    [ payload[:top_skills].size, "Skills" ],
    [ payload[:certifications].size, "Certs" ]
  ]
  summary_compact = payload[:summary].to_s.length <= 420
  compact_role = lambda do |position|
    bullet_characters = position[:bullets].sum { |bullet| bullet[:content].to_s.length }

    position[:summary].to_s.length <= 170 &&
      position[:bullets].size <= 3 &&
      bullet_characters <= 360
  end
  compact_company = lambda do |group|
    group[:positions].size == 1 && compact_role.call(group[:positions].first)
  end
  compact_education = lambda do |education|
    entry_length = [
      education[:institution],
      education[:degree_name],
      education[:field_of_study]
    ].sum { |value| value.to_s.length }

    entry_length <= 150
  end
  compact_certifications_panel = payload[:certifications].size.positive? &&
    payload[:certifications].size <= 4 &&
    payload[:certifications].sum { |certification| certification[:name].to_s.length } <= 180
%>

<article class="resume-page">
  <header class="resume-hero">
    <div class="identity-block">
      <p class="eyebrow">Curriculum Vitae</p>
      <h1 class="resume-name"><%= payload[:full_name] %></h1>

      <% if payload[:headline].present? %>
        <p class="resume-headline"><%= payload[:headline] %></p>
      <% end %>

      <ul class="meta-list" aria-label="Quick profile summary">
        <% if hero_location.present? %>
          <li class="meta-chip"><%= hero_location %></li>
        <% end %>
        <% if contact[:email].present? %>
          <li class="meta-chip"><%= contact[:email] %></li>
        <% end %>
        <% if contact[:phone].present? %>
          <li class="meta-chip"><%= contact[:phone] %></li>
        <% end %>
      </ul>
      
      <dl class="facts-list">
        <% facts.each do |value, label| %>
          <div class="fact-item">
            <dt class="fact-value"><%= value %></dt>
            <dd class="fact-label"><%= label %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </header>

  <div class="resume-body">
    <main class="main-column">
      <% if payload[:summary].present? %>
        <section class="section summary-section">
          <div class="section-heading">
            <div>
              <p class="section-kicker">Overview</p>
              <h2 class="section-title">Professional summary</h2>
            </div>
          </div>
          <p class="summary-text <%= "compact-block" if summary_compact %>"><%= payload[:summary] %></p>
        </section>
      <% end %>

      <section class="section">
        <div class="section-heading">
          <div>
            <p class="section-kicker">Experience</p>
            <h2 class="section-title">Professional experience</h2>
          </div>
        </div>

        <% if payload[:experience_groups].any? %>
          <div class="company-list">
            <% payload[:experience_groups].each do |group| %>
              <article class="company-block <%= "compact-block" if compact_company.call(group) %>">
                <header class="company-header">
                  <div>
                    <h3 class="company-name"><%= group[:company_name] %></h3>
                    <% if group[:location].present? %>
                      <p class="company-location"><%= group[:location] %></p>
                    <% end %>
                  </div>
                </header>

                <div class="role-list">
                  <% group[:positions].each do |position| %>
                    <section class="role-block <%= "compact-block" if compact_role.call(position) %>">
                      <div class="role-header">
                        <div>
                          <h4 class="role-title"><%= position[:title] %></h4>
                          <% if position[:summary].present? %>
                            <p class="role-summary"><%= position[:summary] %></p>
                          <% end %>
                        </div>
                        <p class="date-range"><%= format_period.call(position[:start_date], position[:end_date], position[:current]) %></p>
                      </div>

                      <% if position[:bullets].any? %>
                        <ul class="achievement-list">
                          <% position[:bullets].each do |bullet| %>
                            <li><%= bullet[:content] %></li>
                          <% end %>
                        </ul>
                      <% end %>
                    </section>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>
        <% else %>
          <p class="empty-state">No experience entries yet.</p>
        <% end %>
      </section>

      <section class="section">
        <div class="section-heading">
          <div>
            <p class="section-kicker">Education</p>
            <h2 class="section-title">Education</h2>
          </div>
        </div>

        <% if payload[:educations].any? %>
          <div class="education-list">
            <% payload[:educations].each do |education| %>
              <article class="education-item <%= "compact-block" if compact_education.call(education) %>">
                <div>
                  <h3 class="education-school"><%= education[:institution] %></h3>
                  <% if education[:degree_name].present? || education[:field_of_study].present? %>
                    <p class="education-degree"><%= [ education[:degree_name], education[:field_of_study] ].reject(&:blank?).join(" · ") %></p>
                  <% end %>
                </div>
                <p class="date-range"><%= format_period.call(education[:start_date], education[:end_date], education[:current]) %></p>
              </article>
            <% end %>
          </div>
        <% else %>
          <p class="empty-state">No education entries yet.</p>
        <% end %>
      </section>
    </main>

    <aside class="sidebar-column">
      <section class="sidebar-panel profile-panel">
        <div class="profile-frame">
          <% if resume&.avatar&.attached? %>
            <img
              src="<%= ApplicationHelper.embed_attachment(resume.avatar) %>"
              alt="<%= payload[:full_name] %>"
              class="avatar"
              width="220"
              height="275"
            >
          <% else %>
            <span class="profile-placeholder"><%= profile_initials %></span>
          <% end %>
        </div>
      </section>

      <section class="sidebar-panel contact-panel compact-panel">
        <div class="section-heading sidebar-heading">
          <div>
            <p class="section-kicker">Contact</p>
            <h2 class="section-title">Contact</h2>
          </div>
        </div>

        <dl class="contact-list">
          <% contact_entries.each do |label, value, href| %>
            <div class="contact-row">
              <dt class="contact-label"><%= label %></dt>
              <dd class="contact-value">
                <% if href.present? %>
                  <%= link_to value, href, class: "resource-link", target: "_blank", rel: "noreferrer noopener" %>
                <% else %>
                  <span><%= value %></span>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>
      </section>

      <section class="sidebar-panel">
        <div class="section-heading sidebar-heading">
          <div>
            <p class="section-kicker">Skills</p>
            <h2 class="section-title">Top skills</h2>
          </div>
        </div>

        <% if payload[:top_skills].any? %>
          <ul class="skill-list" aria-label="Top skills">
            <% payload[:top_skills].each do |top_skill| %>
              <li class="skill-pill"><%= top_skill[:name] %></li>
            <% end %>
          </ul>
        <% else %>
          <p class="empty-state">No top skills added.</p>
        <% end %>
      </section>

      <section class="sidebar-panel <%= "compact-panel" if compact_certifications_panel %>">
        <div class="section-heading sidebar-heading">
          <div>
            <p class="section-kicker">Credentials</p>
            <h2 class="section-title">Certifications</h2>
          </div>
        </div>

        <% if payload[:certifications].any? %>
          <ul class="certification-list" aria-label="Certifications">
            <% payload[:certifications].each do |certification| %>
              <li class="certification-item"><%= certification[:name] %></li>
            <% end %>
          </ul>
        <% else %>
          <p class="empty-state">No certifications added.</p>
        <% end %>
      </section>
    </aside>
  </div>
</article>
