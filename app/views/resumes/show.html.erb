<% resume ||= @resume %>
<div class="row">
  <main class="col-9 pr-0">
    <header class="header">
      <div class="container">
        <div class="row">
          <div class="col-3 d-flex justify-content-end">
            <img
              src="<%= ApplicationHelper.embed_attachment(resume.avatar) %>"
              alt="<%= resume.full_name %>"
              class="avatar"
              width="75"
              height="75"
            >
          </div>
          <div class="col-9 d-flex flex-column gap-0 pt-2">
            <h1 class="accent title"><%= resume.full_name %></h1>
            <h5 class="title"><%= resume.job_title %></h5>
          </div>
        </div>
      </div>
    </header>
    <section class="main-section">
      <div class="container">
        <div class="row">
          <div class="col-3 d-flex justify-content-end position-relative">
            <div class="section-icon-dot">
              <img src="<%= ApplicationHelper.embed_image('alvo.png') %>" alt="">
            </div>
          </div>
          <div class="col-9 thread-effect">
            <div class="experience-item">
              <h4 class="accent title">Perfil Profissional</h4>
              <div class="row">
                <div class="col-auto pt-2 px-0">
                  <div class="experience-dot">
                  </div>
                </div>
                <div class="col">
                  <h6>
                    <%= resume.summary %>
                  </h6>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-3 d-flex justify-content-end">
            <div class="section-icon-dot">
              <img src="<%= ApplicationHelper.embed_image('mala-de-viagem.png') %>" alt="">
            </div>
          </div>
          <div class="col-9 thread-effect">
            <div class="experience-item">
              <h4 class="accent title">Experiência Profissional</h4>
              <% resume.experiences.order(start_date: :desc).each do |experience| %>
                <div class="row pb-2 position-relative">
                  <h5 class="date-working">
                    <%= experience.start_date.strftime("%m/%Y") %> -<br>
                    <%= experience.current ? 'Atual' : experience.end_date&.strftime("%m/%Y") %>
                  </h5>
                  <div class="col-auto pt-2 px-0">
                    <div class="experience-dot">
                    </div>
                  </div>
                  <div class="col">
                    <h5 class="title">
                      <%= experience.job_title %>
                    </h5>
                    <h6>
                      <%= experience.company %><%= ", #{experience.location}" if experience.location.present? %>
                    </h6>
                    <ul>
                      <% experience.description.split("\n").each do |item| %>
                        <li><%= item %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              <% end %>
              <% if resume.old_experiences_summary.present? %>
                <div class="row">
                  <div class="col-12 ps-4 mt-1">
                    <h6 class="small">
                      <%= resume.old_experiences_summary %>
                    </h6>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-3 d-flex justify-content-end">
            <div class="section-icon-dot">
              <img src="<%= ApplicationHelper.embed_image('educacao.png') %>" alt="">
            </div>
          </div>
          <div class="col-9 thread-effect">
            <div class="experience-item">
              <h4 class="accent title">Educação</h4>
              <% resume.educations.order(start_date: :desc).each do |education| %>
                <div class="row pb-2 position-relative">
                  <h5 class="date-working">
                    <%= education.start_date.strftime("%m/%Y") %> -<br>
                    <%= education.current ? 'Atual' : education.end_date&.strftime("%m/%Y") %>
                  </h5>
                  <div class="col-auto pt-2 px-0">
                    <div class="experience-dot">
                    </div>
                  </div>
                  <div class="col">
                    <h5 class="title">
                      <%= education.degree %>
                    </h5>
                    <h6>
                      <%= education.institution %>
                    </h6>
                    <% if education.location.present? %>
                      <h6>
                        <%= education.location %>
                      </h6>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        <!-- Competências Técnicas -->
        <div class="row">
          <div class="col-3 d-flex justify-content-end">
            <div class="section-icon-dot">
              <img src="<%= ApplicationHelper.embed_image('cerebro.png') %>" alt="">
            </div>
          </div>
          <div class="col-9 thread-effect">
            <div class="experience-item">
              <h4 class="accent title">Competências Técnicas</h4>
              <div class="row ps-2">
                <div class="col-12">
                  <% resume.technical_skills.each do |ts| %>
                    <h6 class="mb-1"><strong><%= ts.category %>:</strong> <%= ts.name %></h6>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Projetos em Destaque -->
        <div class="row">
          <div class="col-3 d-flex justify-content-end">
            <div class="section-icon-dot">
              <img src="<%= ApplicationHelper.embed_image('projetos.png') %>" alt="">
            </div>
          </div>
          <div class="col-9 thread-effect">
            <div class="experience-item">
              <h4 class="accent title">Projetos em Destaque</h4>
              <div class="row ps-2">
                <% resume.projects.each do |project| %>
                  <div class="col-12 mb-2">
                    <h5 class="title"><%= project.title %></h5>
                    <h6><%= project.description %></h6>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <!-- Preenchimento lateral -->
  <aside class="col-3 pl-0">
    <div class="sidebar-section">
      <div class="d-flex align-items-center gap-2 mb-2">
        <div class="sidebar-icon-dot">
          <img src="<%= ApplicationHelper.embed_image('contato.png') %>" alt="">
        </div>
        <h3 class="accent title pt-2">Contato</h3>
      </div>
      <div class="contact-list ps-4">
        <div class="contact-item mb-2">
          <h6 class="title mb-0">Endereço</h6>
          <span class="small"><%= resume.address %></span>
        </div>
        <div class="contact-item mb-2">
          <h6 class="title mb-0">Telefone</h6>
          <span class="small"><%= resume.phone %></span>
        </div>
        <div class="contact-item mb-2">
          <h6 class="title mb-0">E-mail</h6>
          <span class="small">
            <a href="mailto:<%= resume.email %>?subject=Nosso novo Senior" class="text-decoration-none"><%= resume.email %></a>
          </span>
        </div>
        <div class="contact-item mb-2">
          <h6 class="title mb-0">LinkedIn</h6>
          <span class="small text-break">
            <a href="<%= resume.linkedin_url %>" target="_blank" class="text-decoration-none"><%= resume.linkedin_url.gsub("https://www.", "") %></a>
          </span>
        </div>
        <div class="contact-item mb-2">
          <h6 class="title mb-0">GitHub</h6>
          <span class="small text-break">
            <a href="<%= resume.github_url %>" target="_blank" class="text-decoration-none"><%= resume.github_url.gsub("https://", "") %></a>
          </span>
        </div>
      </div>
    </div>

    <div class="sidebar-section mt-4">
      <div class="d-flex align-items-center gap-2 mb-2">
        <div class="sidebar-icon-dot">
          <img src="<%= ApplicationHelper.embed_image('habilidades.png') %>" alt="">
        </div>
        <h3 class="accent title pt-2">Soft Skills</h3>
      </div>
      <div class="skills-list ps-4">
        <% resume.skills.each do |skill| %>
          <div class="skill-item mb-2 d-flex flex-column align-items-end">
            <div class="small w-100 text-start"><%= skill.name %></div>
            <div class="skill-dots d-flex gap-1">
              <% 5.times do |i| %>
                <div class="skill-dot <%= i < skill.level ? 'filled' : '' %>"></div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="sidebar-section mt-4">
      <div class="d-flex align-items-center gap-2 mb-2">
        <div class="sidebar-icon-dot">
          <img src="<%= ApplicationHelper.embed_image('software.png') %>" alt="">
        </div>
        <h3 class="accent title pt-2">Software</h3>
      </div>
      <div class="skills-list ps-4">
        <% resume.softwares.each do |software| %>
          <div class="skill-item mb-2 d-flex flex-column align-items-end">
            <div class="small w-100 text-start"><%= software.name %></div>
            <div class="skill-dots d-flex gap-1">
              <% 5.times do |i| %>
                <div class="skill-dot <%= i < software.level ? 'filled' : '' %>"></div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="sidebar-section mt-4">
      <div class="d-flex align-items-center gap-2 mb-2">
        <div class="sidebar-icon-dot">
          <img src="<%= ApplicationHelper.embed_image('idiomas.png') %>" alt="">
        </div>
        <h3 class="accent title pt-2">Idiomas</h3>
      </div>
      <div class="skills-list ps-4">
        <div class="mb-3">
          <% resume.languages.each do |language| %>
            <div class="skill-item mb-1 d-flex flex-column align-items-end">
              <div class="small w-100 text-start"><%= language.name %></div>
              <div class="skill-dots d-flex gap-1">
                <% 5.times do |i| %>
                  <div class="skill-dot <%= i < language.level ? 'filled' : '' %>"></div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="sidebar-section mt-4">
      <div class="d-flex align-items-center gap-2 mb-2">
        <div class="sidebar-icon-dot">
          <img src="<%= ApplicationHelper.embed_image('hobbies.png') %>" alt="">
        </div>
        <h3 class="accent title pt-2">Hobbies</h3>
      </div>
      <div class="skills-list ps-4">
        <div class="mb-3">
          <% resume.hobbies.group_by(&:category).each do |category, hobbies| %>
            <div>
              <h6 class="title <%= 'mt-3' unless category == resume.hobbies.first&.category %> mb-1 small"><%= category %></h6>
              <% hobbies.each do |hobby| %>
                <div class="small"><%= hobby.name %></div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </aside>
</div>